# Neon Database Connection Configuration
# Replace with your actual Neon credentials
DATABASE_URL=postgresql://<username>:<password>@<neon-endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
PGHOST=<neon-endpoint>-pooler.<region>.aws.neon.tech
PGDATABASE=<dbname>
PGUSER=<username>
PGPASSWORD=<password>
PGPORT=5432
PGSSLMODE=require
ENDPOINT_ID=<neon-endpoint-id>
PROJECT_ID=<neon-project-id>
ORG_ID=<neon-org-id>
BRANCH=production

# Spring Boot Datasource Mappings
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# App Config
PORT=5000
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
FRONTEND_URL=http://localhost:5173
